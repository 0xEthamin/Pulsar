# Bluetooth Classic through Bluedroid, controller in BR/EDR mode, A2DP sink.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# The A2DP sink decodes and calls back from the BTC task, and esp-idf-svc
# formats every A2DP event there before the callback runs.
CONFIG_BT_BTC_TASK_STACK_SIZE=15000

# The module carries 8 MB of flash. One factory app of 1.5 MB, no OTA.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# The PHY calibrates at every boot instead of storing its data in NVS.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# The Rust main task brings up the radio and the I2S channel on its own stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
